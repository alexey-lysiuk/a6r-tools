{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "bmpfile.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/bmpfile.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/data",
            "args": [
                "capture.bmp"
            ]
        },
        {
            "name": "tinysa4preset.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/tinysa4preset.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/data",
            "args": [
                "startup.prs",
                "multi-band.prs",
                "startup.json",
                "multi-band.json"
            ]
        },
        {
            "name": "tinysa4preset-viewer (Extension)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode/tinysa4preset-viewer",
                "${workspaceFolder}/data/startup.prs"
            ]
        },
        {
            "name": "remotecontrol.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/remotecontrol.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/data",
            "args": [
                "--help"
            ]
        }
    ]
}
