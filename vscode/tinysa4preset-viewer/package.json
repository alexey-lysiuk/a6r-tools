{
    "name": "tinysa4preset-viewer",
    "displayName": "tinySA4 Preset Viewer",
    "description": "Read-only viewer for tinySA4 preset files (.prs)",
    "version": "0.1.0",
    "publisher": "alexey-lysiuk",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/alexey-lysiuk/a6r-tools",
    "repository": {
        "type": "git",
        "url": "https://github.com/alexey-lysiuk/a6r-tools.git",
        "directory": "vscode/tinysa4preset-viewer"
    },
    "bugs": {
        "url": "https://github.com/alexey-lysiuk/a6r-tools/issues"
    },
    "keywords": [
        "tinysa",
        "tinySA4",
        "preset",
        "viewer",
        "rf",
        "spectrum"
    ],
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "tinysa4preset-viewer.presetViewer",
                "displayName": "tinySA4 Preset Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.prs"
                    }
                ],
                "priority": "default"
            }
        ]
    }
}
